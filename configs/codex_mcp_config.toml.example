# Current Codex MCP configuration shape (global ~/.codex/config.toml or a
# trusted project's .codex/config.toml). The recommended command is the
# upstream-supported uvx path. Use `bmcpw configure codex` for an idempotent
# merge, backup, and Windows path escaping.

[mcp_servers.blender]
command = "uvx"
args = ["--python", "3.11", "blender-mcp"]
startup_timeout_sec = 20
tool_timeout_sec = 60
default_tools_approval_mode = "writes"

[mcp_servers.blender.env]
# The companion never enables upstream telemetry implicitly.
DISABLE_TELEMETRY = "true"
